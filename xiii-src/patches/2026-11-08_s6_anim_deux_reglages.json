[["<label>Réduction des animations<small>Boutons en icônes seules, texte en bulle au survol : les barres ne bougent plus. Pour toute la suite.</small></label><div class=\"xs-c\"><label class=\"xs-sw\"><input type=\"checkbox\" data-xred' + (XRED.on() ? ' checked' : '') + '><span></span></label>", "<label>Réduire les animations des outils<small>Boutons en icônes seules, texte en bulle au survol, aucune transition. Pour toute la suite.</small></label><div class=\"xs-c\"><label class=\"xs-sw\"><input type=\"checkbox\" data-xred' + (XRED.on() ? ' checked' : '') + '><span></span></label></div></div><div class=\"xs-f\"><label>Réduire les animations du Dashboard<small>À l\\'ouverture de l\\'accueil : widgets affichés d\\'un coup, sans cascade, compteurs ni graphiques animés.</small></label><div class=\"xs-c\"><label class=\"xs-sw\"><input type=\"checkbox\" data-xreddash' + ((function () { try { return localStorage.getItem('xiii.anim.dash') === '1'; } catch (e) { return false; } })() ? ' checked' : '') + '><span></span></label>", 20], ["document.addEventListener('change', function (e) { if (e.target.matches && e.target.matches('[data-xred]')) set(e.target.checked);", "document.addEventListener('change', function (e) { if (e.target.matches && e.target.matches('[data-xreddash]')) { try { localStorage.setItem('xiii.anim.dash', e.target.checked ? '1' : '0'); } catch (x) { } } if (e.target.matches && e.target.matches('[data-xred]')) set(e.target.checked);", 20], ["    document.addEventListener('mouseover', function (e) {\n        if (!on()) return;", "    document.addEventListener('mouseover', function (e) {\n        if (!on() && !(e.target.closest && e.target.closest('#top-bar,#toolbar'))) return; // dans les barres : bulle toujours, le bouton ne s'élargit plus au survol", 20]]